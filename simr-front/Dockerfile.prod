# Etapa 1: Build de la aplicación Angular
FROM node:18-alpine AS build

WORKDIR /usr/src/app

# Copiar archivos de configuración desde simr-front
COPY simr-front/package*.json ./

# Instalar dependencias
RUN npm ci

# Copiar el archivo .env.production desde la raíz del proyecto
COPY .env.production ./.env.production

# Copiar código fuente desde simr-front
COPY simr-front/ .

# Ejecutar script de reemplazo de variables de entorno
RUN node replace-env.js

# Build de producción
RUN npm run build -- --configuration production

# Etapa 2: Servir con Nginx
FROM nginx:alpine

# Copiar archivos construidos al directorio de Nginx
COPY --from=build /usr/src/app/dist/simr-front /usr/share/nginx/html

# Copiar configuración de Nginx desde simr-front
COPY simr-front/nginx.conf /etc/nginx/conf.d/default.conf

# Exponer puerto
EXPOSE 80

# Comando por defecto
CMD ["nginx", "-g", "daemon off;"]
