<div class="container" ng-controller="ExampleController">
    <div><img src="img/logomr.png" alt="Logo"> </div>
    
    <!-- Formulario manejado por AngularJS -->
    <form class="form-login" ng-submit="loginUser()" name="loginForm">
        <label>Usuario:</label>
        <input type="text"  class="form-control " name="username" ng-model="credentials.username" required/>
        <label>Contraseña:</label>
        <input type="password"class="form-control" name="password" ng-model="credentials.password" required/>
        <input type="submit" class="btn btn-primary pull-right" value="Identificarse" ng-disabled="loginForm.$invalid">
    </form>

    <br>
    <a href="/signup">Registrarse</a>
    <a href="/">Regresar</a>
</div>

