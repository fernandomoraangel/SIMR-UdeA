# Exclude node_modules directory anywhere in the project
**/node_modules

#========================================
# [BACKEND]
# Logs
/simr-back/logs
/simr-back/*.log
/simr-back/npm-debug.log*

# Dependency directories
/simr-back/pids
/simr-back/logs
/simr-back/*.pid
/simr-back/*.seed
/simr-back/*.pid.lock

# Environment variables
# /simr-back/.env* # ACTIVAR EN PRODUCCIÓN


#========================================
# [FRONTEND]
# Compiled output
/simr-front/dist
/simr-front/tmp
/simr-front/out-tsc
/simr-front/bazel-out

# Node
/simr-front/npm-debug.log
/simr-front/yarn-error.log

# IDEs and editors
/simr-front/.idea/
/simr-front/.project
/simr-front/.classpath
/simr-front/.c9/
/simr-front/*.launch
/simr-front/.settings/
/simr-front/*.sublime-workspace

# Visual Studio Code
/simr-front/.vscode/*
/simr-front/!.vscode/settings.json
/simr-front/!.vscode/tasks.json
/simr-front/!.vscode/launch.json
/simr-front/!.vscode/extensions.json
/simr-front/.history/*

# Miscellaneous
/simr-front/.angular/cache
/simr-front/.sass-cache/
/simr-front/connect.lock
/simr-front/coverage
/simr-front/libpeerconnection.log
/simr-front/testem.log
/simr-front/typings

# System files
/simr-front/.DS_Store
/simr-front/Thumbs.db
simr-back/public/core/.DS_Store
.DS_Store
Thumbs.db

#========================================
# [DOCKER & INFRASTRUCTURE]
# MinIO data directory (runtime data, not config)
minio-data/
minio-data/**

# Docker runtime volumes data (not the volume definitions)
volumes/data/
volumes/logs/

# SSL certificates with private keys (keep .crt templates if needed)
*.key
*.pem
ssl/private/

#========================================
# [ENVIRONMENT & CONFIG]
# Environment files with sensitive data (uncomment for production)
# .env
# .env.local
# .env.production
# simr-back/.env*
# simr-front/.env*

# Local configuration overrides (keep base configs)
config/local.js
config/local.json
config/production.local.js

#========================================
# [LOGS & TEMPORARY FILES]
# Log files
*.log
logs/
**/*.log

# Temporary files
*.tmp
*.temp
.cache/
.tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

#========================================
# [IDE & EDITOR FILES]
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

#========================================
# [BACKUP & ARCHIVE FILES]
# Backup files
*.bak
*.backup
*.old
*.orig

# Archive files
*.zip
*.tar
*.tar.gz
*.rar
*.7z
